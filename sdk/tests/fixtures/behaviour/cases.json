  "an_update_due_and_applied": {
   "section": 1,
   "status": "new",
   "says": "The caller says an update was due and was applied.",
   "given": {
    "init": {
     "auto_step": false
    },
    "calls": [
     "session.step(skipped=False)"
    ]
   },
   "expected": {
    "records_carry": [
     {
      "step_skipped": false
     }
    ],
    "records_lack": [
     "step_skipped_by"
    ]
   }
  },
  "an_update_due_and_skipped": {
   "section": 1,
   "status": "new",
   "says": "The caller says an update was due and was skipped, and there is no scaler.",
   "given": {
    "init": {
     "auto_step": false
    },
    "calls": [
     "session.step(skipped=True)"
    ]
   },
   "expected": {
    "records_carry": [
     {
      "step_skipped": true,
      "step_skipped_by": "caller"
     }
    ]
   }
  },
  "a_skip_only_the_caller_reported": {
   "section": 1,
   "status": "new",
   "says": "The caller says the update was skipped; the SDK observed the scaler given to `init` apply it. The record says both.",
   "given": {
    "init": {
     "auto_step": false,
     "scaler": "a GradScaler that applied this step"
    },
    "calls": [
     "session.step(skipped=True)"
    ]
   },
   "expected": {
    "records_carry": [
     {
      "step_skipped": true,
      "step_skipped_by": "caller",
      "scaler_applied": true
     }
    ]
   }
  },
  "a_skip_the_caller_reported_with_no_scaler_outcome": {
   "section": 1,
   "status": "new",
   "says": "The caller says the update was skipped; a scaler was given to `init`, and it did not act on this update, so its outcome is unknown. The record does not say the scaler applied it.",
   "given": {
    "init": {
     "auto_step": false,
     "scaler": "a GradScaler whose `step` was not called for this update"
    },
    "calls": [
     "session.step(skipped=True)"
    ]
   },
   "expected": {
    "records_carry": [
     {
      "step_skipped": true,
      "step_skipped_by": "caller"
     }
    ],
    "records_lack": [
     "scaler_applied"
    ]
   }
  },
  "a_skip_only_the_scaler_reported": {
   "section": 1,
   "status": "new",
   "says": "The caller says the update was applied; the scaler skipped it. Either one saying so makes it skipped.",
   "given": {
    "init": {
     "auto_step": false,
     "scaler": "a GradScaler that skipped this step"
    },
    "calls": [
     "session.step(skipped=False)"
    ]
   },
   "expected": {
    "records_carry": [
     {
      "step_skipped": true,
      "step_skipped_by": "scaler"
     }
    ]
   }
  },
  "a_skip_both_reported": {
   "section": 1,
   "status": "new",
   "says": "The caller and the scaler both say the same update was skipped.",
   "given": {
    "init": {
     "auto_step": false,
     "scaler": "a GradScaler that skipped this step"
    },
    "calls": [
