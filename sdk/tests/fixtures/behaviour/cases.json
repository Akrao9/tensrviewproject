     }
    ]
   }
  },
  "an_accumulation_microstep": {
   "section": 1,
   "status": "new",
   "says": "Four forward and backward passes are accumulated into one update. The caller marks the one boundary, and the three microsteps before it end no record.",
   "given": {
    "init": {
     "auto_step": false
    },
    "calls": [
     "(backward)",
     "(backward)",
     "(backward)",
     "(backward)",
     "session.step(skipped=False)"
    ]
   },
   "expected": {
    "records_carry": [
     {
      "step_skipped": false
     }
    ],
    "records": 1
   }
  },
