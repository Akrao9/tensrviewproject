  "a_gradient_not_finite_on_a_skipped_step": {
   "section": 1,
   "status": "pin",
   "says": "A gradient norm that is not finite on a skipped step is what the skip is for. Nothing is raised for it.",
   "detector": "detect_non_finite",
   "records": [
    {
     "step": 3,
     "grad_norm": "nan",
     "step_skipped": true
    }
   ],
   "expected": {
    "fires": false
   }
  },
  "an_activation_not_finite_on_a_skipped_step": {
   "section": 1,
   "status": "pin",
   "says": "A layer statistic that is not finite is raised on a skipped step too: activations are still read.",
   "detector": "detect_non_finite",
   "records": [
    {
     "step": 3,
     "grad_norm": "nan",
     "step_skipped": true,
     "layers": {
      "blk": {
       "mean": "nan",
       "std": 1.0,
       "abs_max": 1.0
      }
     }
    }
   ],
   "expected": {
    "fires": true,
    "kind": "non_finite",
    "step": 3
   }
  },
