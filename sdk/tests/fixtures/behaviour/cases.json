     {
      "step": 0,
      "step_skipped": true,
      "weights_unchanged": [
       "blk.weight"
      ],
      "grad_norms": {
       "blk.weight": 0.5
      }
     },
     {
      "step": 1,
      "step_skipped": true,
      "weights_unchanged": [
       "blk.weight"
      ],
      "grad_norms": {
       "blk.weight": 0.5
      }
     },
     {
      "step": 2,
      "step_skipped": true,
      "weights_unchanged": [
       "blk.weight"
      ],
      "grad_norms": {
       "blk.weight": 0.5
      }
     }
    ]
   },
   "expected": {
    "incident_kinds_absent": [
     "stalled_weights"
    ]
   },
   "today": {
    "detector": "detect_stalled_weights",
    "fires": true,
    "kind": "stalled_weights",
    "step": 2
   }
  },
